# Copy to .env and set the credentials locally. Never commit .env.
JOBMARKET_LLM_PROVIDER=openai
JOBMARKET_LLM_MODEL=your-provider-model
JOBMARKET_LLM_API_KEY=
# Set this for providers without a built-in OpenAI-compatible endpoint.
# JOBMARKET_LLM_BASE_URL=https://provider.example/v1/chat/completions

# Optional extraction tuning
# JOB_MAX_WORKERS=6
# JOB_SCRAPER_MIN_REQUEST_INTERVAL=1.0
# PROXY_POOL_TTL=300
# JOB_DATABASE_PATH=jobs.db
